<Window x:Class="AppPicker.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AppPicker — выбор окон" Height="780" Width="1120" MinHeight="620" MinWidth="860" Background="#111116" Foreground="#F4F2F8" FontFamily="Segoe UI">
 <Window.Resources><SolidColorBrush x:Key="Panel" Color="#1A1A22"/><SolidColorBrush x:Key="Muted" Color="#A09DAC"/><Style TargetType="Button"><Setter Property="Foreground" Value="#F7F3FF"/><Setter Property="Background" Value="#292632"/><Setter Property="BorderBrush" Value="#403A4A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style></Window.Resources>
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,22"><StackPanel><TextBlock Text="Выберите приложения" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Отметьте окна, которые хотите держать в своём списке." Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="↻  Обновить" Click="Refresh_Click" VerticalAlignment="Center"/></DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="16" Padding="18"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Запущенные приложения" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="WindowsList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Click="WindowCard_Click" Width="205" Height="92" Margin="0,0,10,10" Padding="12" HorizontalContentAlignment="Left"><Button.Style><Style TargetType="Button"><Setter Property="Background" Value="#23222B"/><Setter Property="BorderBrush" Value="#35323E"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#382454"/><Setter Property="BorderBrush" Value="#B77AFF"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ProcessName}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/><TextBlock Text="✓ Выбрано" Foreground="#D7B5FF" FontSize="11" Margin="0,3,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel></Border>
   <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="16" Padding="18"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Выбрано" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/><ItemsControl x:Name="SelectedList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#23212B" CornerRadius="10" Padding="12" Margin="0,0,0,9"><DockPanel><Button DockPanel.Dock="Right" Content="Убрать" Padding="8,5" Click="RemoveSelected_Click"/><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ProcessName}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DockPanel></Border>
  </Grid>
  <Border Grid.Row="2" Background="#1A1A22" CornerRadius="13" Padding="15" Margin="0,18,0,0"><StackPanel><TextBlock Text="Приватность окна AppPicker" FontWeight="SemiBold"/><CheckBox x:Name="OwnCaptureCheck" Content="Исключать собственное окно AppPicker из захвата экрана (если поддерживается Windows)" Checked="OwnCapture_Click" Unchecked="OwnCapture_Click" Foreground="#DDD8E7" Margin="0,9,0,4"/><TextBlock Text="Действует только на окно AppPicker. Windows не гарантирует защиту от всех способов захвата; сторонние окна не скрываются. Чтобы показать программу без рабочего стола и других окон, выберите в приложении трансляции демонстрацию отдельного окна." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="StatusText" Foreground="#CBB1EF" Margin="0,8,0,0"/></StackPanel></Border>
 </Grid>
</Window>
