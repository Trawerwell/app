<Window x:Class="AppPicker.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AppPicker — приложения" Width="1080" Height="760" MinWidth="820" MinHeight="580" Background="#101117" Foreground="#F6F3FA" FontFamily="Segoe UI">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#1B1D27"/>
    <SolidColorBrush x:Key="Muted" Color="#B2ADBD"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F6F3FA"/><Setter Property="Background" Value="#32303E"/><Setter Property="BorderBrush" Value="#474254"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Выберите приложения" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Нажмите на карточку, чтобы добавить программу в список." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
      <Button Grid.Column="1" Content="↻  Обновить" Click="Refresh_Click" VerticalAlignment="Center"/>
    </Grid>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="16" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Открытые приложения" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBox x:Name="SearchBox" Grid.Row="1" Height="38" Padding="11,8" Margin="0,0,0,14" Background="#272934" Foreground="#F6F3FA" BorderBrush="#444050" CaretBrush="#C792FF" TextChanged="Search_Changed" ToolTip="Поиск по названию приложения или окна"/>
        <Grid Grid.Row="2"><TextBlock x:Name="EmptyText" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="AppsList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Click="Card_Click" Width="200" Height="100" Margin="0,0,10,10" Padding="12" HorizontalContentAlignment="Stretch"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="#F6F3FA"/><Setter Property="Background" Value="#272934"/><Setter Property="BorderBrush" Value="#444050"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#3B2856"/><Setter Property="BorderBrush" Value="#BD86FF"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><DockPanel><Image Source="{Binding IconSource}" Width="27" Height="27" Margin="0,0,9,0"/><TextBlock Text="{Binding Name}" Foreground="#F6F3FA" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding Title}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,9,0,0"/><TextBlock Text="✓ Выбрано" Foreground="#D7B5FF" FontSize="11" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid>
      </Grid></Border>
      <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="16" Padding="18"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Выбрано" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="SelectedList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#292A36" CornerRadius="10" Padding="11" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" Foreground="#F6F3FA" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding StateText}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="Убрать" Padding="9,5" Margin="8,0,0,0" Click="Remove_Click"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel></Border>
    </Grid>
    <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="13" Padding="15" Margin="0,18,0,0"><StackPanel><TextBlock Text="Приватность окна AppPicker" FontWeight="SemiBold"/><CheckBox x:Name="OwnCaptureCheck" Content="Исключить окно AppPicker из захвата экрана" Checked="Capture_Changed" Unchecked="Capture_Changed" Foreground="#F6F3FA" Margin="0,9,0,5"/><CheckBox x:Name="MaskCheck" Content="Эксперимент: чёрные маски для выбранных приложений при показе всего экрана" Checked="Mask_Changed" Unchecked="Mask_Changed" Foreground="#F6F3FA" Margin="0,7,0,5"/><TextBlock Text="Маски создаются AppPicker поверх выбранных окон и должны выглядеть почти прозрачными для вас. Захват всего экрана может показать чёрные прямоугольники; на Windows 10 и в разных программах захвата результат не гарантирован. Захват отдельного окна обходит маску. Проверяйте предпросмотр трансляции перед показом конфиденциального содержимого." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="StatusText" Foreground="#D2B0FF" Margin="0,8,0,0"/></StackPanel></Border>
  </Grid>
</Window>

